Bootstrap: localimage
From: /data/SBBS-BuschLab/containers/Alpine-3.24.3.sif

%labels
    Author Ian Sealy
    Version 1.75.1

%post
    apk --no-cache add --virtual build-dependencies go git
    git clone https://github.com/rclone/rclone.git
    cd rclone
    git checkout tags/v1.75.1
    GOMAXPROCS=2 go build -p 1
    mkdir -p /usr/local/man/man1
    cp rclone /usr/local/bin
    cp rclone.1 /usr/local/man/man1
    go clean -modcache
    cd ..
    rm -rf rclone $HOME/go $HOME/.cache
    apk del build-dependencies

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%runscript
    /usr/local/bin/rclone "$@"

%help
    rclone - rsync for cloud storage
